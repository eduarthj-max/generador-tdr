# Clave de la API de Anthropic (https://platform.claude.com) — obligatoria
ANTHROPIC_API_KEY=

# Modelo de Claude a usar (por defecto claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Nivel de esfuerzo de razonamiento: low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# Contraseña de acceso a la app (recomendada si la publicas en internet).
# Usuario: cualquiera. Si se deja vacía, la app queda abierta.
APP_PASSWORD=

# Carpeta donde se guardan las referencias subidas (por defecto ./data)
DATA_DIR=./data
